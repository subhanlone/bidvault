# Leave unset for local runs. playwright.config.ts defaults to http://localhost:5173
# and starts the dev server for you.
#
# Pointing this at a deployment runs the suite against the one production database --
# these specs sign real accounts in and submit a deliberate wrong password. The config
# refuses a known production host unless ALLOW_PRODUCTION_E2E=1 is also set.
# BASE_URL=

TEST_BUYER_EMAIL=buyer@example.com
TEST_BUYER_PASSWORD=yourpassword

TEST_SELLER_EMAIL=seller@example.com
TEST_SELLER_PASSWORD=yourpassword

TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=yourpassword
