# Copy to .env.local and fill in.

# Backend API base URL, including /api/v1, no trailing slash.
#
# The refresh token is an HttpOnly cookie set by the API, so the API has to be on the SAME SITE as the
# page (cookies are SameSite=Strict). localhost:5173 -> localhost:4000 is the same site. In production
# that means the frontend at https://www.bidvault.tech and the API at https://api.bidvault.tech, NOT
# a *.railway.app address: a different site never receives the cookie, so a reload would sign you out.
VITE_API_URL=http://localhost:4000/api/v1
